<odoo>
    <record id="view_product_template_form_autocode" model="ir.ui.view">
        <field name="name">product.template.form.autocode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- XPath relatif au champ default_code -->
            <xpath expr="//field[@name='default_code']" position="attributes">
                <attribute name="readonly">0</attribute> <!-- ou 1 si tu veux readonly -->
            </xpath>
        </field>
    </record>
</odoo>