<odoo>
    <data>
      <record id="purchase_order_form_niherit" model="ir.ui.view">
		<field name="name">purchase.order.view.form.inherit</field>
		<field name="model">purchase.order</field>
		<field name="inherit_id" ref="purchase.purchase_order_form"/>
		<field name="arch" type="xml">
			<xpath expr="//page[@name='products']//tree//field[@name='product_qty']" position="attributes">
				<attribute name="widget">integer_only</attribute>
			</xpath>
		</field>
	  </record>
    </data>
</odoo>