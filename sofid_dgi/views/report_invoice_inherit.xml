<odoo>
    <template id="report_invoice_inherit" inherit_id="account.report_invoice_document">

        <!-- ======================= -->
        <!-- 1️⃣ Ajouter colonne Remise (€) -->
        <!-- ======================= -->
        <xpath expr="//table[@name='invoice_line_table']//th[@name='th_price_unit']" position="after">
            <th t-if="display_discount" name="th_discount_amount"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Prix remisé</span>
            </th>
        </xpath>

        <!-- ======================= -->
        <!-- 2️⃣ Afficher le montant remisé par ligne (utiliser position='after' sur la cellule %remise) -->
        <!-- ======================= -->
        <xpath expr="//table[@name='invoice_line_table']//td[span[@t-field='line.discount']]" position="after">
            <td t-if="display_discount"
                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span t-esc="line.price_unit * line.quantity * line.discount / 100.0"
                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
            </td>
        </xpath>

    </template>
</odoo>
