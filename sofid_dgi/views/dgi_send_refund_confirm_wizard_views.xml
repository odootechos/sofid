<odoo>
    <record id="view_dgi_send_refund_confirm_wizard" model="ir.ui.view">
        <field name="name">dgi.send.refund.confirm.wizard.form</field>
        <field name="model">dgi.send.refund.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmation la facture d'avoir FNE">
                <div>
                    <p style="font-size:16px; font-weight:bold;">
                        Voulez-vous vraiment envoyer cette facture d'avoir  à la DGI ?
                    </p>
                </div>

                <footer>
                    <button name="action_confirm_refund"
                            string="Oui, envoyer"
                            type="object"
                            class="btn-primary"/>

                    <button string="Annuler"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
