<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="stock_quant_view_inherit" model="ir.ui.view">
            <field name="name">stock.quant.view.form.inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_apply_inventory']" position="attributes">
                    <attribute name="groups">sofid_stock.group_stock_validator</attribute>
                </xpath>
                <xpath expr="//field[@name='inventory_quantity']" position="attributes">
                    <attribute name="widget">integer_only</attribute>
                </xpath>
            </field>
        </record>
    
    </data>
    

</odoo>
