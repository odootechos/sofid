<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- SERVICES -->
    <!-- ===================================================== -->

    <!-- FORM -->
    <record id="fleet_vehicle_log_services_form_employee" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.form.employee</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='purchaser_id']" position="replace">
                <field name="employee_purchaser_id"/>
            </xpath>
        </field>
    </record>

